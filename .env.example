# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copia a .env.local y completa los valores
# NUNCA commitear .env.local ni .env con valores reales
# ──────────────────────────────────────────────────────────────────────────────

# ─── Supabase (REQUERIDO) ─────────────────────────────────────────────────────
# URL del proyecto Supabase (visible en Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave anon/public de Supabase (expuesta en el browser — no usar para writes sensibles)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb...

# Clave service_role de Supabase (SOLO servidor — nunca exponer con NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhb...

# ─── Mapbox (REQUERIDO para mapas) ───────────────────────────────────────────
# Token público para GL JS en el browser
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Token server-side para Geocoding y Directions API (puede ser el mismo)
MAPBOX_API_KEY=sk.eyJ1...

# ─── Redis / Upstash (OPCIONAL — habilita rate limiting y caché) ──────────────
# Si no se configura, el rate limiting y circuit breaker quedan deshabilitados
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# ─── Alertas / Notificaciones (OPCIONAL) ─────────────────────────────────────
# Webhook para recibir alertas operacionales
WEBHOOK_URL=https://hooks.slack.com/services/...

# Email para alertas críticas (requiere configurar un provider en notify.ts)
ALERT_EMAIL=ops@tuapp.com

# Umbrales de alerta para cache hit ratio (0.0 — 1.0)
ADMIN_ALERT_GEOCODE_HIT_RATIO=0.5
ADMIN_ALERT_DIRECTIONS_HIT_RATIO=0.5

# ─── Admin (OPCIONAL — no usar NEXT_PUBLIC_ para tokens secretos) ────────────
# Token para proteger endpoints internos de métricas (solo servidor)
ADMIN_METRICS_TOKEN=cambia-este-token-secreto
