# QA test environment — copy to .env.test and fill in values
# NEVER commit .env.test to git

# Target URL (default: http://localhost:3000 for local dev)
QA_BASE_URL=http://localhost:3000

# Test user credentials
QA_CLIENTE_EMAIL=
QA_CLIENTE_PASSWORD=

QA_DRIVER_EMAIL=
QA_DRIVER_PASSWORD=

QA_TECNICO_EMAIL=
QA_TECNICO_PASSWORD=

QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
